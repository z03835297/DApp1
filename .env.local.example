# 复制为 .env.local 后按需修改（docker compose / scripts/run-docker.sh 均使用该文件）

NEXT_PUBLIC_API_URL="http://localhost:3000"

# 可选：仅用于本地模拟 Cloudflare Pages 等托管平台的构建流程。
# 正常本地开发请直接维护 contracts.json 文件（见 contracts.example.json），无需设置这个变量；
# 若 contracts.json 已存在，构建时会优先使用该文件，此变量不会生效。
# 部署到 Cloudflare Pages 时，应在其项目的 Environment variables 设置里配置同名变量
# （而不是写在这个文件里，.env.local 不会被提交也不会同步到 Cloudflare）。
# CONTRACTS_JSON='{"1":{"v1":{"TOKEN":"0x...","USDT":"0x...","VAULT":"0x..."}}}'
